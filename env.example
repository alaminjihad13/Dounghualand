# ============================================================
# DonghuaLand - Environment Variables / Cloudflare Secrets
# ============================================================
# This file is an EXAMPLE. Do NOT commit real values.
# For local development: copy to .dev.vars (Cloudflare Workers local dev format)
# For production: use `wrangler pages secret put <NAME>` command
# ============================================================

# ---- JWT SECRET (REQUIRED) ----
# Used for signing JWT tokens for user authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ---- TMDB API KEY (OPTIONAL but recommended) ----
# Used for auto-filling anime data in Admin Panel
# Get your free key at: https://www.themoviedb.org/settings/api
# This is a v3 API key (NOT the read access token)
TMDB_API_KEY=your_tmdb_api_v3_key_here

# ---- CLOUDINARY CREDENTIALS (REQUIRED for image uploads) ----
# Used for profile images, cover images, and admin image uploads
# Get your free account at: https://cloudinary.com/users/register_free
# Find these in: Cloudinary Dashboard → API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---- ADMIN SECRET (OPTIONAL - legacy) ----
# Not actively used - admin login uses hardcoded credentials
# Admin username: admin
# Admin password: admin1122
ADMIN_SECRET=admin1122

# ============================================================
# IMPORTANT NOTES:
# ============================================================
# 1. The D1 database ID is set in wrangler.jsonc, not here
# 2. For local dev (.dev.vars format):
#    JWT_SECRET=your_value
# 3. For production (Cloudflare Pages):
#    npx wrangler pages secret put JWT_SECRET --project-name donghualand
#    npx wrangler pages secret put TMDB_API_KEY --project-name donghualand
#    npx wrangler pages secret put CLOUDINARY_CLOUD_NAME --project-name donghualand
#    npx wrangler pages secret put CLOUDINARY_API_KEY --project-name donghualand
#    npx wrangler pages secret put CLOUDINARY_API_SECRET --project-name donghualand
# ============================================================
